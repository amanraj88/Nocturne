# NOCTURNE Environment Configuration Template
# Copy this file to .env.local to configure external services.

# ==============================================================================
# Supabase Configuration (Free Tier)
# ==============================================================================
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (safe for client-side browser bundles, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (server-side only, for administrative tasks / seeds)
# NEVER expose this key to browser client bundles or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# YouTube Configuration (Optional)
# ==============================================================================
# Optional: YouTube Data API v3 key for in-app search inside NOCTURNE.
# When unset, direct YouTube URL/ID paste works natively without any API key or credentials.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ==============================================================================
# Scheduled Tasks & Cron Security
# ==============================================================================
# Secret token for authenticating scheduled cron invocations (/api/rooms/cleanup).
# Vercel Cron automatically passes this as 'Authorization: Bearer <CRON_SECRET>'.
# In GitHub Actions, add this to Repository Secrets as CRON_SECRET.
CRON_SECRET=your_random_32_char_cron_secret_here

# ==============================================================================
# Server Configuration
# ==============================================================================
# Port for local development / testing server
PORT=3002
