# NOCTURNE Environment Configuration Template
# Copy to .env.local to configure optional external services.

# Optional: YouTube Data API v3 key for live catalog search inside NOCTURNE.
# When unset, direct YouTube URL/ID paste works natively without any API key or credentials.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Port for local server (defaults to 3000 or specified via -p flag)
PORT=3002
